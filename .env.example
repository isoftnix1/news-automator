# Google Sheets Configuration
GOOGLE_SHEET_ID=replace_with_spreadsheet_id
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json
GOOGLE_SHEET_TAB=News

# Date organization mode: 'both' (master sheet + daily tabs), 'tabs' (daily tabs only), or 'sheet' (single sheet)
SHEET_DATE_MODE=both

# Gemini API key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Discovery & Search Behavior
GOOGLE_NEWS_ENABLED=true
GDELT_ENABLED=true
SEARCH_EVERY_HOURS=3
MIN_RELEVANCE_SCORE=75
MAX_ARTICLES_PER_QUERY=50
MAX_QUERIES_PER_RUN=12
MAX_EVALUATIONS_PER_RUN=25
LOOKBACK_HOURS=72
RUN_ON_START=true

# Optional API endpoints and logging
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
LOG_LEVEL=info
